###############################################################################
#  SkyRoute - Ontología de logística de una flota de drones de entrega urbana
#  Introducción a la Inteligencia Artificial - UNAL Medellín
#  Serialización: Turtle   |   Semántica: RDF / RDFS (+ FOAF y Dublin Core)
###############################################################################

@prefix dr:      <http://unal.edu.co/ia/drones#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

###############################################################################
# 1. CLASES (rdfs:Class) y JERARQUÍAS (rdfs:subClassOf)
###############################################################################

# --- Vehículos ---------------------------------------------------------------
dr:Vehiculo a rdfs:Class ;
    rdfs:label "Vehículo: cualquier medio de transporte usado para mover paquetes."@es .

dr:Dron a rdfs:Class ;
    rdfs:subClassOf dr:Vehiculo ;
    rdfs:label "Dron: vehículo aéreo no tripulado de la flota de entregas."@es .

dr:DronLigero a rdfs:Class ;
    rdfs:subClassOf dr:Dron ;
    rdfs:label "Dron ligero: dron ágil de baja capacidad de carga (hasta 2 kg)."@es .

dr:DronPesado a rdfs:Class ;
    rdfs:subClassOf dr:Dron ;
    rdfs:label "Dron pesado: dron de alta capacidad de carga (hasta 10 kg)."@es .

dr:DronRefrigerado a rdfs:Class ;
    rdfs:subClassOf dr:Dron ;
    rdfs:label "Dron refrigerado: dron con compartimento de temperatura controlada (hasta 5 kg)."@es .

# --- Paquetes ----------------------------------------------------------------
dr:Paquete a rdfs:Class ;
    rdfs:label "Paquete: objeto que un cliente solicita entregar."@es .

dr:PaqueteUrgente a rdfs:Class ;
    rdfs:subClassOf dr:Paquete ;
    rdfs:label "Paquete urgente: paquete que debe entregarse con prioridad."@es .

dr:PaqueteMedico a rdfs:Class ;
    rdfs:subClassOf dr:PaqueteUrgente ;
    rdfs:label "Paquete médico: medicamentos o muestras clínicas; siempre es urgente."@es .

dr:PaqueteFragil a rdfs:Class ;
    rdfs:subClassOf dr:Paquete ;
    rdfs:label "Paquete frágil: paquete que requiere manipulación y vuelo cuidadosos."@es .

# --- Ubicaciones -------------------------------------------------------------
dr:Ubicacion a rdfs:Class ;
    rdfs:label "Ubicación: lugar de la ciudad que puede ser origen o destino de un vuelo."@es .

dr:Zona a rdfs:Class ;
    rdfs:subClassOf dr:Ubicacion ;
    rdfs:label "Zona: sector urbano de la ciudad."@es .

dr:ZonaResidencial a rdfs:Class ;
    rdfs:subClassOf dr:Zona ;
    rdfs:label "Zona residencial: sector de viviendas; se permite volar."@es .

dr:ZonaComercial a rdfs:Class ;
    rdfs:subClassOf dr:Zona ;
    rdfs:label "Zona comercial: sector de comercio o industria; se permite volar."@es .

dr:ZonaRestringida a rdfs:Class ;
    rdfs:subClassOf dr:Zona ;
    rdfs:label "Zona restringida: sector donde está prohibido el vuelo de drones."@es .

dr:EstacionCarga a rdfs:Class ;
    rdfs:subClassOf dr:Ubicacion ;
    rdfs:label "Estación de carga: base donde los drones recargan batería y despegan."@es .

# --- Personas (se reutiliza la clase foaf:Person del vocabulario FOAF) --------
dr:Operador a rdfs:Class ;
    rdfs:subClassOf foaf:Person ;
    rdfs:label "Operador: persona responsable de supervisar drones."@es .

dr:Cliente a rdfs:Class ;
    rdfs:subClassOf foaf:Person ;
    rdfs:label "Cliente: persona que solicita el envío de paquetes."@es .

# --- Operación ---------------------------------------------------------------
dr:Mision a rdfs:Class ;
    rdfs:label "Misión: encargo de llevar un paquete desde una estación hasta una zona."@es .

dr:CondicionClimatica a rdfs:Class ;
    rdfs:label "Condición climática: registro del clima en un momento dado."@es .

###############################################################################
# 2. PROPIEDADES (rdf:Property) con DOMINIO y RANGO
###############################################################################

# --- Propiedades de objeto (rango = una clase / URI) --------------------------
dr:transporta a rdf:Property ;
    rdfs:domain dr:Dron ;
    rdfs:range  dr:Paquete ;
    rdfs:label "transporta: el dron lleva actualmente este paquete."@es .

dr:involucraUbicacion a rdf:Property ;
    rdfs:domain dr:Mision ;
    rdfs:range  dr:Ubicacion ;
    rdfs:label "involucra ubicación: la misión pasa por esta ubicación (origen o destino)."@es .

dr:tieneOrigen a rdf:Property ;
    rdfs:subPropertyOf dr:involucraUbicacion ;
    rdfs:domain dr:Mision ;
    rdfs:range  dr:EstacionCarga ;
    rdfs:label "tiene origen: estación desde la que despega la misión."@es .

dr:tieneDestino a rdf:Property ;
    rdfs:subPropertyOf dr:involucraUbicacion ;
    rdfs:domain dr:Mision ;
    rdfs:range  dr:Zona ;
    rdfs:label "tiene destino: zona donde se entrega el paquete de la misión."@es .

dr:incluyePaquete a rdf:Property ;
    rdfs:domain dr:Mision ;
    rdfs:range  dr:Paquete ;
    rdfs:label "incluye paquete: paquete que se entrega en la misión."@es .

dr:seRecargaEn a rdf:Property ;
    rdfs:domain dr:Dron ;
    rdfs:range  dr:EstacionCarga ;
    rdfs:label "se recarga en: estación base asignada al dron."@es .

dr:supervisadoPor a rdf:Property ;
    rdfs:domain dr:Dron ;
    rdfs:range  dr:Operador ;
    rdfs:label "supervisado por: operador responsable del dron."@es .

dr:solicitadoPor a rdf:Property ;
    rdfs:domain dr:Paquete ;
    rdfs:range  dr:Cliente ;
    rdfs:label "solicitado por: cliente que pidió el envío del paquete."@es .

dr:ubicadaEn a rdf:Property ;
    rdfs:domain dr:EstacionCarga ;
    rdfs:range  dr:Zona ;
    rdfs:label "ubicada en: zona donde se encuentra la estación de carga."@es .

dr:zonaActual a rdf:Property ;
    rdfs:domain dr:Dron ;
    rdfs:range  dr:Zona ;
    rdfs:label "zona actual: zona donde se encuentra el dron en este momento."@es .

# --- Propiedades de datos (rango = literal tipado con XML Schema) ------------
dr:nivelBateria a rdf:Property ;
    rdfs:domain dr:Dron ;
    rdfs:range  xsd:decimal ;
    rdfs:label "nivel de batería: carga restante del dron, en porcentaje (0-100)."@es .

dr:capacidadKg a rdf:Property ;
    rdfs:domain dr:Dron ;
    rdfs:range  xsd:decimal ;
    rdfs:label "capacidad (kg): peso máximo que el dron puede cargar."@es .

dr:estadoOperativo a rdf:Property ;
    rdfs:domain dr:Dron ;
    rdfs:range  xsd:string ;
    rdfs:label "estado operativo: disponible, en_vuelo, recargando o mantenimiento."@es .

dr:pesoKg a rdf:Property ;
    rdfs:domain dr:Paquete ;
    rdfs:range  xsd:decimal ;
    rdfs:label "peso (kg): peso del paquete."@es .

dr:distanciaKm a rdf:Property ;
    rdfs:domain dr:Mision ;
    rdfs:range  xsd:decimal ;
    rdfs:label "distancia (km): longitud del trayecto de la misión."@es .

dr:cuposDisponibles a rdf:Property ;
    rdfs:domain dr:EstacionCarga ;
    rdfs:range  xsd:integer ;
    rdfs:label "cupos disponibles: número de drones que aún pueden recargar en la estación."@es .

dr:velocidadVientoKmh a rdf:Property ;
    rdfs:domain dr:CondicionClimatica ;
    rdfs:range  xsd:decimal ;
    rdfs:label "velocidad del viento (km/h): viento medido en el registro climático."@es .

dr:tipoCondicion a rdf:Property ;
    rdfs:domain dr:CondicionClimatica ;
    rdfs:range  xsd:string ;
    rdfs:label "tipo de condición: despejado, lluvia o tormenta."@es .

dr:momento a rdf:Property ;
    rdfs:domain dr:CondicionClimatica ;
    rdfs:range  xsd:integer ;
    rdfs:label "momento: orden temporal del registro climático (mayor = más reciente)."@es .

###############################################################################
# 3. INDIVIDUOS (mínimo 4 por clase)
###############################################################################

# --- Zonas (4 residenciales, 4 comerciales, 4 restringidas) ------------------
dr:Z01 a dr:ZonaResidencial ; rdfs:label "Laureles" .
dr:Z02 a dr:ZonaResidencial ; rdfs:label "El Poblado" .
dr:Z05 a dr:ZonaResidencial ; rdfs:label "Belén" .
dr:Z07 a dr:ZonaResidencial ; rdfs:label "Robledo" .

dr:Z03 a dr:ZonaComercial ; rdfs:label "Centro" .
dr:Z06 a dr:ZonaComercial ; rdfs:label "Guayabal" .
dr:Z08 a dr:ZonaComercial ; rdfs:label "Milla de Oro" .
dr:Z09 a dr:ZonaComercial ; rdfs:label "San Diego" .

dr:Z04 a dr:ZonaRestringida ; rdfs:label "Aeropuerto Olaya Herrera" .
dr:Z10 a dr:ZonaRestringida ; rdfs:label "Cuarta Brigada" .
dr:Z11 a dr:ZonaRestringida ; rdfs:label "Cárcel Bellavista" .
dr:Z12 a dr:ZonaRestringida ; rdfs:label "Estadio Atanasio Girardot" .

# --- Estaciones de carga -----------------------------------------------------
dr:E01 a dr:EstacionCarga ; dr:ubicadaEn dr:Z01 ; dr:cuposDisponibles 3 .
dr:E02 a dr:EstacionCarga ; dr:ubicadaEn dr:Z03 ; dr:cuposDisponibles 2 .
dr:E03 a dr:EstacionCarga ; dr:ubicadaEn dr:Z05 ; dr:cuposDisponibles 0 .   # llena
dr:E04 a dr:EstacionCarga ; dr:ubicadaEn dr:Z02 ; dr:cuposDisponibles 2 .

# --- Operadores (FOAF: foaf:name) --------------------------------------------
dr:OP01 a dr:Operador ; foaf:name "María Ospina" .
dr:OP02 a dr:Operador ; foaf:name "Andrés Vélez" .
dr:OP03 a dr:Operador ; foaf:name "Sofía Zapata" .
dr:OP04 a dr:Operador ; foaf:name "Julián Arango" .

# --- Clientes ----------------------------------------------------------------
# CL03 y CL04 NO se declaran como Cliente a propósito: el razonador lo infiere
# a partir del rango de dr:solicitadoPor (caso 2 del documento).
dr:CL01 a dr:Cliente ; foaf:name "Ana Restrepo" .
dr:CL02 a dr:Cliente ; foaf:name "Carlos Gómez" .
dr:CL03 foaf:name "Luisa Mejía" .
dr:CL04 foaf:name "Jorge Cardona" .

# --- Drones ------------------------------------------------------------------
dr:D01 a dr:DronLigero ; dr:capacidadKg 2.0 ; dr:nivelBateria 95.0 ;
    dr:estadoOperativo "disponible" ; dr:zonaActual dr:Z01 ;
    dr:seRecargaEn dr:E01 ; dr:supervisadoPor dr:OP01 .
dr:D02 a dr:DronLigero ; dr:capacidadKg 2.0 ; dr:nivelBateria 30.0 ;
    dr:estadoOperativo "disponible" ; dr:zonaActual dr:Z03 ;
    dr:seRecargaEn dr:E02 ; dr:supervisadoPor dr:OP02 .
dr:D03 a dr:DronLigero ; dr:capacidadKg 2.0 ; dr:nivelBateria 12.0 ;
    dr:estadoOperativo "en_vuelo" ; dr:zonaActual dr:Z05 ;
    dr:seRecargaEn dr:E03 ; dr:supervisadoPor dr:OP03 ;
    dr:transporta dr:P07 .
dr:D09 a dr:DronLigero ; dr:capacidadKg 2.0 ; dr:nivelBateria 70.0 ;
    dr:estadoOperativo "disponible" ; dr:zonaActual dr:Z07 ;
    dr:seRecargaEn dr:E01 ; dr:supervisadoPor dr:OP04 .

dr:D04 a dr:DronPesado ; dr:capacidadKg 10.0 ; dr:nivelBateria 80.0 ;
    dr:estadoOperativo "disponible" ; dr:zonaActual dr:Z03 ;
    dr:seRecargaEn dr:E02 ; dr:supervisadoPor dr:OP02 .
dr:D05 a dr:DronPesado ; dr:capacidadKg 10.0 ; dr:nivelBateria 45.0 ;
    dr:estadoOperativo "recargando" ; dr:zonaActual dr:Z02 ;
    dr:seRecargaEn dr:E04 ; dr:supervisadoPor dr:OP01 .
dr:D08 a dr:DronPesado ; dr:capacidadKg 10.0 ; dr:nivelBateria 60.0 ;
    dr:estadoOperativo "mantenimiento" ; dr:zonaActual dr:Z02 ;
    dr:seRecargaEn dr:E04 ; dr:supervisadoPor dr:OP03 .
dr:D10 a dr:DronPesado ; dr:capacidadKg 10.0 ; dr:nivelBateria 88.0 ;
    dr:estadoOperativo "disponible" ; dr:zonaActual dr:Z06 ;
    dr:seRecargaEn dr:E02 ; dr:supervisadoPor dr:OP04 .

dr:D06 a dr:DronRefrigerado ; dr:capacidadKg 5.0 ; dr:nivelBateria 90.0 ;
    dr:estadoOperativo "disponible" ; dr:zonaActual dr:Z01 ;
    dr:seRecargaEn dr:E01 ; dr:supervisadoPor dr:OP01 .
dr:D07 a dr:DronRefrigerado ; dr:capacidadKg 5.0 ; dr:nivelBateria 20.0 ;
    dr:estadoOperativo "disponible" ; dr:zonaActual dr:Z05 ;
    dr:seRecargaEn dr:E03 ; dr:supervisadoPor dr:OP03 .
dr:D11 a dr:DronRefrigerado ; dr:capacidadKg 5.0 ; dr:nivelBateria 65.0 ;
    dr:estadoOperativo "disponible" ; dr:zonaActual dr:Z08 ;
    dr:seRecargaEn dr:E04 ; dr:supervisadoPor dr:OP02 .
dr:D12 a dr:DronRefrigerado ; dr:capacidadKg 5.0 ; dr:nivelBateria 50.0 ;
    dr:estadoOperativo "en_vuelo" ; dr:zonaActual dr:Z09 ;
    dr:seRecargaEn dr:E02 ; dr:supervisadoPor dr:OP04 ;
    dr:transporta dr:P13 .

# --- Paquetes ----------------------------------------------------------------
# Generales (solo dr:Paquete)
dr:P01 a dr:Paquete ; dr:pesoKg 1.2  ; dr:solicitadoPor dr:CL01 .
dr:P04 a dr:Paquete ; dr:pesoKg 7.5  ; dr:solicitadoPor dr:CL02 .
dr:P07 a dr:Paquete ; dr:pesoKg 0.5  ; dr:solicitadoPor dr:CL03 .
dr:P09 a dr:Paquete ; dr:pesoKg 12.0 ; dr:solicitadoPor dr:CL04 .   # ningún dron puede

# Médicos (el razonador infiere que también son PaqueteUrgente y Paquete)
dr:P02 a dr:PaqueteMedico ; dr:pesoKg 0.8 ; dr:solicitadoPor dr:CL01 .
dr:P06 a dr:PaqueteMedico ; dr:pesoKg 3.5 ; dr:solicitadoPor dr:CL02 .
dr:P10 a dr:PaqueteMedico ; dr:pesoKg 1.1 ; dr:solicitadoPor dr:CL03 .
dr:P13 a dr:PaqueteMedico ; dr:pesoKg 2.5 ; dr:solicitadoPor dr:CL04 .

# Express (declarados directamente como urgentes)
dr:P05 a dr:PaqueteUrgente ; dr:pesoKg 1.0 ; dr:solicitadoPor dr:CL02 .
dr:P12 a dr:PaqueteUrgente ; dr:pesoKg 6.0 ; dr:solicitadoPor dr:CL04 .

# Frágiles
dr:P03 a dr:PaqueteFragil ; dr:pesoKg 1.5 ; dr:solicitadoPor dr:CL01 .
dr:P08 a dr:PaqueteFragil ; dr:pesoKg 4.0 ; dr:solicitadoPor dr:CL03 .
dr:P11 a dr:PaqueteFragil ; dr:pesoKg 2.0 ; dr:solicitadoPor dr:CL02 .
dr:P14 a dr:PaqueteFragil ; dr:pesoKg 0.9 ; dr:solicitadoPor dr:CL04 .

# --- Misiones (Dublin Core: dcterms:description) -----------------------------
dr:M01 a dr:Mision ; dr:incluyePaquete dr:P02 ; dr:tieneOrigen dr:E01 ;
    dr:tieneDestino dr:Z05 ; dr:distanciaKm 6.5 ;
    dcterms:description "Entrega de medicamento a Belén." .
dr:M02 a dr:Mision ; dr:incluyePaquete dr:P04 ; dr:tieneOrigen dr:E02 ;
    dr:tieneDestino dr:Z03 ; dr:distanciaKm 2.0 ;
    dcterms:description "Entrega de carga pesada en el Centro." .
dr:M03 a dr:Mision ; dr:incluyePaquete dr:P06 ; dr:tieneOrigen dr:E01 ;
    dr:tieneDestino dr:Z04 ; dr:distanciaKm 5.0 ;
    dcterms:description "Entrega médica con destino en zona restringida." .
dr:M04 a dr:Mision ; dr:incluyePaquete dr:P10 ; dr:tieneOrigen dr:E04 ;
    dr:tieneDestino dr:Z03 ; dr:distanciaKm 4.2 ;
    dcterms:description "Entrega médica al Centro." .
dr:M05 a dr:Mision ; dr:incluyePaquete dr:P09 ; dr:tieneOrigen dr:E02 ;
    dr:tieneDestino dr:Z01 ; dr:distanciaKm 7.0 ;
    dcterms:description "Paquete de 12 kg: excede la capacidad de la flota." .
dr:M06 a dr:Mision ; dr:incluyePaquete dr:P12 ; dr:tieneOrigen dr:E04 ;
    dr:tieneDestino dr:Z05 ; dr:distanciaKm 11.5 ;
    dcterms:description "Envío express pesado de larga distancia." .
dr:M07 a dr:Mision ; dr:incluyePaquete dr:P05 ; dr:tieneOrigen dr:E02 ;
    dr:tieneDestino dr:Z06 ; dr:distanciaKm 3.0 ;
    dcterms:description "Envío express liviano a Guayabal." .
dr:M08 a dr:Mision ; dr:incluyePaquete dr:P08 ; dr:tieneOrigen dr:E04 ;
    dr:tieneDestino dr:Z02 ; dr:distanciaKm 1.5 ;
    dcterms:description "Paquete frágil a El Poblado." .

# --- Condiciones climáticas --------------------------------------------------
dr:C01 a dr:CondicionClimatica ; dr:momento 1 ; dr:velocidadVientoKmh 8.0  ; dr:tipoCondicion "despejado" .
dr:C02 a dr:CondicionClimatica ; dr:momento 2 ; dr:velocidadVientoKmh 25.0 ; dr:tipoCondicion "lluvia" .
dr:C03 a dr:CondicionClimatica ; dr:momento 3 ; dr:velocidadVientoKmh 45.0 ; dr:tipoCondicion "tormenta" .
dr:C04 a dr:CondicionClimatica ; dr:momento 4 ; dr:velocidadVientoKmh 15.0 ; dr:tipoCondicion "despejado" .
